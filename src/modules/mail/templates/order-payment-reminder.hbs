<!-- templates/order-payment-reminder.hbs -->

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f7f9;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .header {
            background: linear-gradient(135deg, #ea580c 0%, #f97316 100%);
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .content {
            padding: 40px;
            color: #334155;
            line-height: 1.6;
        }
        .greeting {
            font-size: 18px;
            margin-bottom: 20px;
        }
        .urgent-box {
            background-color: #fff7ed;
            border: 2px solid #f97316;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        .hours-left {
            font-size: 48px;
            font-weight: 700;
            color: #ea580c;
            margin: 10px 0;
        }
        .order-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 16px;
            margin: 20px 0;
        }
        .total {
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
        }
        .button {
            display: inline-block;
            background-color: #f97316;
            color: #ffffff;
            text-decoration: none;
            padding: 14px 30px;
            border-radius: 8px;
            font-weight: 600;
            margin-top: 20px;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⚠️ ¡Tu pedido está por vencer!</h1>
        </div>
        <div class="content">
            <p class="greeting">Hola <strong>{{customerName}}</strong>,</p>
            <p>Tu pedido está pendiente de pago y el tiempo se está agotando.</p>
            
            <div class="urgent-box">
                <p style="margin: 0 0 8px 0; font-weight: 600;">⏰ Tiempo restante</p>
                <div class="hours-left">{{horasRestantes}} horas</div>
                <p style="margin: 8px 0 0 0; font-size: 14px;">
                    Vence el {{paymentExpiresAt}}
                </p>
            </div>

            <div class="order-box">
                <p style="margin: 0 0 8px 0;"><strong>Pedido:</strong> {{orderNumber}}</p>
                <p style="margin: 0 0 8px 0;"><strong>Método de pago:</strong> {{paymentMethod}}</p>
                <p style="margin: 16px 0 0 0; font-size: 14px;">Total a pagar:</p>
                <div class="total">S/ {{total}}</div>
            </div>

            {{#if whatsappNumber}}
            <div style="text-align: center;">
                <p style="margin-bottom: 16px;">📱 Envía tu comprobante por WhatsApp:</p>
                <a href="https://wa.me/{{whatsappNumber}}" class="button">
                    {{whatsappNumber}}
                </a>
            </div>
            {{/if}}

            <p style="margin-top: 30px; color: #dc2626; font-weight: 600;">
                Si no recibimos tu pago a tiempo, tu pedido será cancelado automáticamente.
            </p>
        </div>
        <div class="footer">
            &copy; 2026 Werd. Todos los derechos reservados.
        </div>
    </div>
</body>
</html>