<!-- templates/order-processing.hbs -->

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f7f9;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .header {
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .content {
            padding: 40px;
            color: #334155;
            line-height: 1.6;
        }
        .greeting {
            font-size: 18px;
            margin-bottom: 20px;
        }
        .status-box {
            background-color: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        .status-icon {
            font-size: 48px;
            margin-bottom: 12px;
        }
        .order-number {
            font-size: 22px;
            font-weight: 700;
            color: #2563eb;
            margin-bottom: 8px;
        }
        .steps-list {
            list-style: none;
            padding: 0;
            margin: 20px 0;
        }
        .steps-list li {
            display: flex;
            align-items: center;
            padding: 10px 0;
            border-bottom: 1px solid #f1f5f9;
            font-size: 14px;
        }
        .step-icon {
            margin-right: 12px;
            font-size: 18px;
            width: 24px;
            text-align: center;
        }
        .step-active {
            font-weight: 700;
            color: #2563eb;
        }
        .step-pending {
            color: #94a3b8;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>📦 Tu pedido está en preparación</h1>
        </div>
        <div class="content">
            <p class="greeting">Hola <strong>{{customerName}}</strong>,</p>
            <p>¡Buenas noticias! Hemos confirmado tu pago y ya estamos preparando tu pedido para enviarlo cuanto antes.</p>

            <div class="status-box">
                <div class="status-icon">⚙️</div>
                <div class="order-number">{{orderNumber}}</div>
                <p style="margin: 0; color: #3b82f6; font-weight: 600;">En preparación</p>
                {{#if estimatedDays}}
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #64748b;">
                    Tiempo estimado de procesamiento: <strong>{{estimatedDays}}</strong>
                </p>
                {{/if}}
            </div>

            <h3 style="margin-bottom: 12px; color: #1e293b;">¿Qué sigue?</h3>
            <ul class="steps-list">
                <li>
                    <span class="step-icon">✅</span>
                    <span><s>Pedido realizado</s></span>
                </li>
                <li>
                    <span class="step-icon">✅</span>
                    <span><s>Pago confirmado</s></span>
                </li>
                <li class="step-active">
                    <span class="step-icon">⚙️</span>
                    <span class="step-active">Preparando tu pedido</span>
                </li>
                <li class="step-pending">
                    <span class="step-icon">🚚</span>
                    <span>Enviado</span>
                </li>
                <li class="step-pending">
                    <span class="step-icon">🎉</span>
                    <span>Entregado</span>
                </li>
            </ul>

            <p style="margin-top: 20px; color: #64748b; font-size: 14px;">
                Te notificaremos por correo cuando tu pedido haya sido despachado.
            </p>
        </div>
        <div class="footer">
            &copy; 2026 Werd. Todos los derechos reservados.
        </div>
    </div>
</body>
</html>
