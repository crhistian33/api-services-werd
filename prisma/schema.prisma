// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// ENUMS
// =============================================================

enum ImageEntityType {
  PRODUCT
  CATEGORY
  BRAND
  SITE_CONFIG
  USER
  HERO_SLIDE
}

enum ProductStatus {
  draft
  active
  inactive
  out_of_stock
}

enum CartStatus {
  active
  checkout_in_progress
  completed
  abandoned
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

enum PromotionTarget {
  product
  category
  global
}

enum PaymentMethodType {
  card
  wallet
  cash_code
  cash_on_delivery
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum LinkType {
  product
  category
  external
  none
}

enum PageStatus {
  draft
  published
}

enum ComplaintType {
  reclamo
  queja
}

enum ComplaintStatus {
  open
  in_review
  resolved
  closed
}

enum AdminPermissionModule {
  products
  categories
  brands
  orders
  customers
  promotions
  coupons
  shipping
  payments
  media
  pages
  site_config
  reports
  admin_users
}

enum DeliveryUnit {
  minutes
  hours
  days
}

// =============================================================
// IMÁGENES (sistema polimórfico reutilizable)
// =============================================================

model Image {
  id          String          @id @default(uuid())
  entityType  ImageEntityType
  entityId    String
  imageRole   String
  tempPath    String?
  finalPath   String?
  url         String?
  order       Int             @default(0)
  altText     String?
  metadata    Json            @default("{}")
  isConfirmed Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([entityType, entityId])
  @@index([entityType, entityId, imageRole])
  @@index([isConfirmed, createdAt])
  @@map("images")
}

// =============================================================
// CATEGORÍAS
// =============================================================

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdById String?
  updatedById String?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  heroSlides HeroSlide[]
  createdBy  AdminUser?  @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy  AdminUser?  @relation("CategoryUpdatedBy", fields: [updatedById], references: [id])
  deletedBy  AdminUser?  @relation("CategoryDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

// =============================================================
// MARCAS
// =============================================================

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdById String?
  updatedById String?
  deletedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products  Product[]
  createdBy AdminUser? @relation("BrandCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser? @relation("BrandUpdatedBy", fields: [updatedById], references: [id])
  deletedBy AdminUser? @relation("BrandDeletedBy", fields: [deletedById], references: [id])

  @@index([deletedAt])
  @@index([slug])
  @@map("brands")
}

// =============================================================
// PRODUCTOS
// =============================================================

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  description      String?
  categoryId       String
  brandId          String?
  status           ProductStatus @default(draft)
  isFeatured       Boolean       @default(false)
  stock            Int           @default(0)
  weight           Decimal?      @db.Decimal(8, 3)
  metaTitle        String?
  metaDescription  String?
  createdById      String?
  updatedById      String?
  deletedById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  category     Category              @relation(fields: [categoryId], references: [id])
  brand        Brand?                @relation(fields: [brandId], references: [id])
  price        ProductPrice?
  priceHistory ProductPriceHistory[]
  specs        ProductSpec[]
  features     ProductFeature[]
  orderItems   OrderItem[]
  reviews      ProductReview[]
  cartItems    CartItem[]
  heroSlides   HeroSlide[]
  createdBy    AdminUser?            @relation("ProductCreatedBy", fields: [createdById], references: [id])
  updatedBy    AdminUser?            @relation("ProductUpdatedBy", fields: [updatedById], references: [id])
  deletedBy    AdminUser?            @relation("ProductDeletedBy", fields: [deletedById], references: [id])

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
  @@index([deletedAt])
  @@map("products")
}

model ProductPrice {
  id             String   @id @default(uuid())
  productId      String   @unique
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  cost           Decimal? @db.Decimal(12, 2)
  currency       String   @default("PEN") @db.Char(3)
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model ProductPriceHistory {
  id            String   @id @default(uuid())
  productId     String
  price         Decimal  @db.Decimal(12, 2)
  cost          Decimal? @db.Decimal(12, 2)
  marginPct     Decimal? @db.Decimal(6, 4)
  changedById   String?
  reason        String?
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy AdminUser? @relation("PriceHistoryChangedBy", fields: [changedById], references: [id])

  @@index([productId, effectiveFrom(sort: Desc)])
  @@map("product_price_history")
}

model ProductSpec {
  id        String @id @default(uuid())
  productId String
  specKey   String
  specValue String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specs")
}

model ProductFeature {
  id        String @id @default(uuid())
  productId String
  feature   String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_features")
}

// =============================================================
// PROMOCIONES
// =============================================================

model Promotion {
  id             String          @id @default(uuid())
  name           String
  description    String?
  discountType   DiscountType
  discountValue  Decimal         @db.Decimal(10, 2)
  appliesTo      PromotionTarget @default(global)
  targetIds      String[]
  minOrderAmount Decimal?        @db.Decimal(12, 2)
  startsAt       DateTime
  endsAt         DateTime?
  isActive       Boolean         @default(true)
  createdById    String?
  updatedById    String?
  deletedById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  orderItems OrderItem[]
  createdBy  AdminUser?  @relation("PromotionCreatedBy", fields: [createdById], references: [id])
  updatedBy  AdminUser?  @relation("PromotionUpdatedBy", fields: [updatedById], references: [id])
  deletedBy  AdminUser?  @relation("PromotionDeletedBy", fields: [deletedById], references: [id])

  @@index([isActive, startsAt, endsAt])
  @@index([deletedAt])
  @@map("promotions")
}

// =============================================================
// CUPONES
// =============================================================

model Coupon {
  id                String          @id @default(uuid())
  code              String          @unique
  discountType      DiscountType
  discountValue     Decimal         @db.Decimal(10, 2)
  minOrderAmount    Decimal         @default(0) @db.Decimal(12, 2)
  maxDiscountAmount Decimal?        @db.Decimal(12, 2)
  usageLimit        Int?
  usageLimitPerUser Int             @default(1)
  timesUsed         Int             @default(0)
  appliesTo         PromotionTarget @default(global)
  targetIds         String[]
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean         @default(true)
  createdById       String?
  updatedById       String?
  deletedById       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?

  usages    CouponUsage[]
  orders    Order[]
  createdBy AdminUser?    @relation("CouponCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser?    @relation("CouponUpdatedBy", fields: [updatedById], references: [id])
  deletedBy AdminUser?    @relation("CouponDeletedBy", fields: [deletedById], references: [id])

  @@index([code])
  @@index([isActive, expiresAt])
  @@index([deletedAt])
  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  orderId         String   @unique
  customerId      String?
  guestEmail      String?
  discountApplied Decimal  @db.Decimal(12, 2)
  usedAt          DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id])
  order    Order     @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@map("coupon_usages")
}

// =============================================================
// CLIENTES
// =============================================================

model Customer {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  updatedById     String?
  deletedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  addresses    CustomerAddress[]
  orders       Order[]
  carts        Cart[]
  reviews      ProductReview[]
  couponUsages CouponUsage[]
  verificationCodes CustomerVerificationCode[]
  customerRefreshTokens CustomerRefreshToken[]
  
  updatedBy  AdminUser?  @relation("CustomerUpdatedBy", fields: [updatedById], references: [id])
  deletedBy AdminUser?    @relation("CustomerDeletedBy", fields: [deletedById], references: [id])

  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

model CustomerVerificationCode {
  id         String   @id @default(uuid())
  code       String   // Código de 6 dígitos
  email      String
  expiresAt  DateTime
  customerId String
  createdAt  DateTime @default(now())
  
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("customer_verification_codes")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  alias         String?
  recipientName String
  phone         String?
  departmentId  String
  provinceId    String
  districtId    String
  addressLine   String
  reference     String?
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  department    Department @relation(fields: [departmentId], references: [id])
  province      Province   @relation(fields: [provinceId], references: [id])
  district      District   @relation(fields: [districtId], references: [id])

  @@index([customerId])
  @@index([districtId])
  @@map("customer_addresses")
}

// =============================================================
// CARRITO
// =============================================================

model Cart {
  id         String     @id @default(uuid())
  token      String     @unique @default(uuid())
  customerId String?
  status     CartStatus @default(active)
  orderId    String?    @unique
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([token])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id             String    @id @default(uuid())
  cartId         String
  productId      String
  quantity       Int
  unitPrice      Decimal   @db.Decimal(12, 2)
  priceUpdatedAt DateTime?
  addedAt        DateTime  @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// =============================================================
// MÉTODOS DE PAGO
// =============================================================

model PaymentMethod {
  id           String            @id @default(uuid())
  code         String            @unique
  name         String
  type         PaymentMethodType
  config       Json              @default("{}")
  instructions String?
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdById  String?
  updatedById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  orders       Order[]
  transactions OrderPaymentTransaction[]
  createdBy    AdminUser?               @relation("PaymentMethodCreatedBy", fields: [createdById], references: [id])
  updatedBy    AdminUser?               @relation("PaymentMethodUpdatedBy", fields: [updatedById], references: [id])

  @@index([isActive])
  @@map("payment_methods")
}

// =============================================================
// ZONAS DE ENVÍO
// =============================================================

model ShippingZone {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  updatedById String?
  deletedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  areas     ShippingZoneArea[]
  rates     ShippingRate[]
  orders    Order[]
  createdBy AdminUser?         @relation("ShippingZoneCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser?         @relation("ShippingZoneUpdatedBy", fields: [updatedById], references: [id])
  deletedBy AdminUser?         @relation("ShippingZoneDeletedBy", fields: [deletedById], references: [id])

  @@map("shipping_zones")
}

model ShippingZoneArea {
  id         String  @id @default(uuid())
  zoneId     String
  departmentId String
  provinceId   String?
  districtId   String?

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id])
  province   Province?  @relation(fields: [provinceId], references: [id])
  district   District?  @relation(fields: [districtId], references: [id])

  @@index([zoneId])
  @@index([departmentId, provinceId, districtId])
  @@map("shipping_zone_areas")
}

model ShippingRate {
  id                    String   @id @default(uuid())
  zoneId                String
  name                  String
  price                 Decimal  @db.Decimal(10, 2)
  minOrderAmount        Decimal  @default(0) @db.Decimal(12, 2)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  estimatedMin          Int?
  estimatedMax          Int?
  estimatedUnit         DeliveryUnit @default(days)
  sortOrder   Int      @default(0)
  isActive              Boolean  @default(true)
  createdById           String?
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdBy AdminUser?   @relation("ShippingRateCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser?   @relation("ShippingRateUpdatedBy", fields: [updatedById], references: [id])

  @@index([zoneId])
  @@map("shipping_rates")
}

// =============================================================
// UBIGEO
// =============================================================

model Department {
  id    String @id // Código de departamento (ej. "15")
  name  String @unique
  
  provinces  Province[]
  zoneAreas  ShippingZoneArea[]
  addresses CustomerAddress[]

  @@map("departments")
}

model Province {
  id           String @id // Código de provincia (ej. "1501")
  name         String
  departmentId String
  
  department Department @relation(fields: [departmentId], references: [id])
  districts  District[]
  zoneAreas  ShippingZoneArea[]
  addresses CustomerAddress[]

  @@unique([name, departmentId])
  @@map("provinces")
}

model District {
  id         String @id // Código de ubigeo completo (ej. "150101")
  name       String
  provinceId String
  
  province  Province           @relation(fields: [provinceId], references: [id])
  zoneAreas ShippingZoneArea[]
  addresses CustomerAddress[]

  @@unique([name, provinceId])
  @@map("districts")
}

// =============================================================
// PEDIDOS
// =============================================================

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerId      String?
  guestEmail      String?
  guestName       String?
  guestPhone      String?
  status          OrderStatus @default(pending_payment)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  couponId        String?
  couponDiscount  Decimal     @default(0) @db.Decimal(12, 2)
  paymentMethodId String
  shippingAddress Json
  shippingZoneId  String?
  notes           String?
  adminNotes      String?
  ipAddress       String?
  placedAt        DateTime    @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer      Customer?                 @relation(fields: [customerId], references: [id])
  coupon        Coupon?                   @relation(fields: [couponId], references: [id])
  paymentMethod PaymentMethod             @relation(fields: [paymentMethodId], references: [id])
  shippingZone  ShippingZone?             @relation(fields: [shippingZoneId], references: [id])
  items         OrderItem[]
  transactions  OrderPaymentTransaction[]
  statusHistory OrderStatusHistory[]
  reviews       ProductReview[]
  couponUsage   CouponUsage?
  complaints    Complaint[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt(sort: Desc)])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  productName    String
  productSku     String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  unitCost       Decimal? @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal  @db.Decimal(12, 2)
  promotionId    String?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderPaymentTransaction {
  id                   String            @id @default(uuid())
  orderId              String
  paymentMethodId      String
  status               TransactionStatus @default(pending)
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("PEN") @db.Char(3)
  gatewayTransactionId String?           @unique
  cipCode              String?
  cipExpiresAt         DateTime?
  gatewayResponse      Json              @default("{}")
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order         Order         @relation(fields: [orderId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([orderId])
  @@map("order_payment_transactions")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  comment     String?
  createdAt   DateTime     @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy AdminUser? @relation("OrderStatusChangedBy", fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// =============================================================
// RESEÑAS
// =============================================================

model ProductReview {
  id           String    @id @default(uuid())
  productId    String
  customerId   String
  orderId      String
  rating       Int
  title        String?
  comment      String?
  isApproved   Boolean   @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  product    Product    @relation(fields: [productId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  reviewedBy AdminUser? @relation("ReviewReviewedBy", fields: [reviewedById], references: [id])

  @@unique([productId, customerId, orderId])
  @@index([productId])
  @@index([isApproved])
  @@map("product_reviews")
}

// =============================================================
// CONFIGURACIÓN DEL SITIO
// =============================================================

model SiteConfig {
  id                String   @id @default(uuid())
  storeName         String
  storeEmail        String
  supportEmail      String?
  phonePrimary      String?
  phoneSecondary    String?
  whatsappNumber    String?
  address           String?
  currency          String   @default("PEN") @db.Char(3)
  taxRate           Decimal  @default(0.18) @db.Decimal(5, 4)
  metaTitle         String?
  metaDescription   String?
  googleAnalyticsId String?
  facebookPixelId   String?
  updatedAt         DateTime @updatedAt

  socialLinks SocialLink[]

  @@map("site_config")
}

model SocialLink {
  id           String  @id @default(uuid())
  siteConfigId String
  network      String
  name         String
  icon         String?
  url          String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  siteConfig SiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade)

  @@index([siteConfigId])
  @@map("social_links")
}

// =============================================================
// HERO SLIDER
// =============================================================

model HeroSlide {
  id             String    @id @default(uuid())
  title          String?
  subtitle       String?
  linkType       LinkType  @default(none)
  linkProductId  String?
  linkCategoryId String?
  linkUrl        String?
  linkText       String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdById    String?
  updatedById    String?
  deletedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  linkProduct  Product?   @relation(fields: [linkProductId], references: [id])
  linkCategory Category?  @relation(fields: [linkCategoryId], references: [id])
  createdBy    AdminUser? @relation("HeroSlideCreatedBy", fields: [createdById], references: [id])
  updatedBy    AdminUser? @relation("HeroSlideUpdatedBy", fields: [updatedById], references: [id])
  deletedBy    AdminUser? @relation("HeroSlideDeletedBy", fields: [deletedById], references: [id])

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("hero_slides")
}

// =============================================================
// PÁGINAS ESTÁTICAS
// =============================================================

model Page {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  content         String?
  metaTitle       String?
  metaDescription String?
  status          PageStatus @default(draft)
  createdById     String?
  updatedById     String?
  deletedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  createdBy AdminUser? @relation("PageCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser? @relation("PageUpdatedBy", fields: [updatedById], references: [id])
  deletedBy AdminUser? @relation("PageDeletedBy", fields: [deletedById], references: [id])

  @@index([slug])
  @@index([status])
  @@index([deletedAt])
  @@map("pages")
}

// =============================================================
// LIBRO DE RECLAMACIONES
// =============================================================

model Complaint {
  id             String          @id @default(uuid())
  ticketNumber   String          @unique
  customerName   String
  documentType   String
  documentNumber String
  email          String
  phone          String?
  orderId        String?
  orderNumber    String?
  complaintType  ComplaintType
  description    String
  status         ComplaintStatus @default(open)
  adminResponse  String?
  managedById    String?
  resolvedById   String?
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  order      Order?     @relation(fields: [orderId], references: [id])
  managedBy  AdminUser? @relation("ComplaintManagedBy", fields: [managedById], references: [id])
  resolvedBy AdminUser? @relation("ComplaintResolvedBy", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

// =============================================================
// ADMINISTRACIÓN — USUARIOS, ROLES Y PERMISOS
// =============================================================

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       AdminUser[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id     String                @id @default(uuid())
  code   String                @unique
  name   String
  module AdminPermissionModule

  roles AdminRolePermission[]

  @@index([module])
  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // ── Relación con rol ──────────────────────────────────────
  role AdminRole @relation(fields: [roleId], references: [id])

  // ── Tokens ───────────────────────────────────────────────
  adminRefreshTokens AdminRefreshToken[]

  // ── Productos ────────────────────────────────────────────
  productsCreated Product[] @relation("ProductCreatedBy")
  productsUpdated Product[] @relation("ProductUpdatedBy")
  productsDeleted Product[] @relation("ProductDeletedBy")

  // ── Categorías ───────────────────────────────────────────
  categoriesCreated Category[] @relation("CategoryCreatedBy")
  categoriesUpdated Category[] @relation("CategoryUpdatedBy")
  categoriesDeleted Category[] @relation("CategoryDeletedBy")

  // ── Marcas ───────────────────────────────────────────────
  brandsCreated Brand[] @relation("BrandCreatedBy")
  brandsUpdated Brand[] @relation("BrandUpdatedBy")
  brandsDeleted Brand[] @relation("BrandDeletedBy")

  // ── Promociones ──────────────────────────────────────────
  promotionsCreated Promotion[] @relation("PromotionCreatedBy")
  promotionsUpdated Promotion[] @relation("PromotionUpdatedBy")
  promotionsDeleted Promotion[] @relation("PromotionDeletedBy")

  // ── Cupones ──────────────────────────────────────────────
  couponsCreated Coupon[] @relation("CouponCreatedBy")
  couponsUpdated Coupon[] @relation("CouponUpdatedBy")
  couponsDeleted Coupon[] @relation("CouponDeletedBy")

  // ── Métodos de pago ──────────────────────────────────────
  paymentMethodsCreated PaymentMethod[] @relation("PaymentMethodCreatedBy")
  paymentMethodsUpdated PaymentMethod[] @relation("PaymentMethodUpdatedBy")

  // ── Zonas y tarifas de envío ─────────────────────────────
  shippingZonesCreated ShippingZone[] @relation("ShippingZoneCreatedBy")
  shippingZonesUpdated ShippingZone[] @relation("ShippingZoneUpdatedBy")
  shippingZonesDeleted ShippingZone[] @relation("ShippingZoneDeletedBy")
  shippingRatesCreated ShippingRate[] @relation("ShippingRateCreatedBy")
  shippingRatesUpdated ShippingRate[] @relation("ShippingRateUpdatedBy")

  // ── Hero Slides ──────────────────────────────────────────
  heroSlidesCreated HeroSlide[] @relation("HeroSlideCreatedBy")
  heroSlidesUpdated HeroSlide[] @relation("HeroSlideUpdatedBy")
  heroSlidesDeleted HeroSlide[] @relation("HeroSlideDeletedBy")

  // ── Páginas ──────────────────────────────────────────────
  pagesCreated Page[] @relation("PageCreatedBy")
  pagesUpdated Page[] @relation("PageUpdatedBy")
  pagesDeleted Page[] @relation("PageDeletedBy")

  // ── Historial de precios ─────────────────────────────────
  priceChanges ProductPriceHistory[] @relation("PriceHistoryChangedBy")

  // ── Historial de estados de pedidos ─────────────────────
  orderStatusChanges OrderStatusHistory[] @relation("OrderStatusChangedBy")

  // ── Reseñas ──────────────────────────────────────────────
  reviewsReviewed ProductReview[] @relation("ReviewReviewedBy")

  // ── Reclamaciones ────────────────────────────────────────
  complaintsManaged  Complaint[] @relation("ComplaintManagedBy")
  complaintsResolved Complaint[] @relation("ComplaintResolvedBy")

  // ── FAQ ──────────────────────────────────────────────────
  faqsCreated Faq[] @relation("FaqCreatedBy")
  faqsUpdated Faq[] @relation("FaqUpdatedBy")

  // ── Clientes ─────────────────────────────────────────────
  customersDeleted Customer[] @relation("CustomerDeletedBy")
  customersUpdated Customer[] @relation("CustomerUpdatedBy")

  @@index([email])
  @@map("admin_users")
}

// =============================================================
// REFRESH TOKENS — ADMIN
// =============================================================

model AdminRefreshToken {
  id          String    @id @default(uuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([tokenHash])
  @@map("admin_refresh_tokens")
}

// =============================================================
// REFRESH TOKENS — CUSTOMER
// =============================================================

model CustomerRefreshToken {
  id          String   @id @default(uuid())
  customerId  String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
  @@map("customer_refresh_tokens")
}

// =============================================================
// FAQ
// =============================================================

model Faq {
  id        String   @id @default(uuid())
  question  String
  answer    String   // HTML richtext
  category  String?  // 'envios' | 'pagos' | 'devoluciones' | 'general'
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdById String?
  updatedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy AdminUser? @relation("FaqCreatedBy", fields: [createdById], references: [id])
  updatedBy AdminUser? @relation("FaqUpdatedBy", fields: [updatedById], references: [id])

  @@index([isActive, sortOrder])
  @@index([category])
  @@map("faqs")
}