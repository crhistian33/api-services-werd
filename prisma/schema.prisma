// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// =============================================================
// ENUMS
// =============================================================

enum ImageEntityType {
  PRODUCT
  CATEGORY
  BRAND
  SITE_CONFIG
  USER
  HERO_SLIDE
}

enum ProductStatus {
  draft
  active
  inactive
  out_of_stock
}

enum CartStatus {
  active
  checkout_in_progress
  completed
  abandoned
}

enum OrderStatus {
  pending_payment
  paid
  processing
  shipped
  delivered
  cancelled
  refunded
}

enum DiscountType {
  percentage
  fixed_amount
  free_shipping
}

enum PromotionTarget {
  product
  category
  global
}

enum PaymentMethodType {
  card
  wallet
  cash_code
  cash_on_delivery
}

enum TransactionStatus {
  pending
  completed
  failed
  refunded
}

enum LinkType {
  product
  category
  external
  none
}

enum PageStatus {
  draft
  published
}

enum ComplaintType {
  reclamo
  queja
}

enum ComplaintStatus {
  open
  in_review
  resolved
  closed
}

enum AdminPermissionModule {
  products
  categories
  brands
  orders
  customers
  promotions
  coupons
  shipping
  payments
  media
  pages
  site_config
  reports
  admin_users
}

// =============================================================
// IMÁGENES (sistema polimórfico reutilizable)
// =============================================================

model Image {
  id          String          @id @default(uuid())
  entityType  ImageEntityType
  entityId    String
  // Roles: main | gallery | logo | logo_header | logo_footer
  //        desktop | mobile | avatar | thumbnail
  imageRole   String
  tempPath    String?
  finalPath   String?
  url         String?
  order       Int             @default(0)
  altText     String?
  // { width, height, size, format, mimeType }
  metadata    Json            @default("{}")
  isConfirmed Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([entityType, entityId])
  @@index([entityType, entityId, imageRole])
  // Índice parcial: solo temporales (para el cron de limpieza)
  @@index([isConfirmed, createdAt])
  @@map("images")
}

// =============================================================
// CATEGORÍAS
// =============================================================

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  parentId    String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // ← nuevo

  parent     Category?   @relation("CategoryTree", fields: [parentId], references: [id])
  children   Category[]  @relation("CategoryTree")
  products   Product[]
  heroSlides HeroSlide[]

  @@index([deletedAt])
  @@index([parentId])
  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

// =============================================================
// MARCAS
// =============================================================

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime? // ← nuevo

  products Product[]

  @@index([deletedAt])
  @@index([slug])
  @@map("brands")
}

// =============================================================
// PRODUCTOS
// =============================================================

model Product {
  id               String        @id @default(uuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  shortDescription String?
  description      String? // HTML richText
  categoryId       String
  brandId          String?
  status           ProductStatus @default(draft)
  isFeatured       Boolean       @default(false)
  stock            Int           @default(0)
  weight           Decimal?      @db.Decimal(8, 3)
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  category     Category              @relation(fields: [categoryId], references: [id])
  brand        Brand?                @relation(fields: [brandId], references: [id])
  price        ProductPrice?
  priceHistory ProductPriceHistory[]
  specs        ProductSpec[]
  features     ProductFeature[]
  orderItems   OrderItem[]
  reviews      ProductReview[]
  cartItems    CartItem[]
  heroSlides   HeroSlide[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([slug])
  @@index([deletedAt])
  @@map("products")
}

// Precio actual del producto (1:1)
model ProductPrice {
  id             String   @id @default(uuid())
  productId      String   @unique
  price          Decimal  @db.Decimal(12, 2)
  // Precio tachado que se muestra en la tienda (precio anterior)
  compareAtPrice Decimal? @db.Decimal(12, 2)
  cost           Decimal? @db.Decimal(12, 2)
  currency       String   @default("PEN") @db.Char(3)
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

// Historial de cambios de precio (auditoría)
model ProductPriceHistory {
  id            String   @id @default(uuid())
  productId     String
  price         Decimal  @db.Decimal(12, 2)
  cost          Decimal? @db.Decimal(12, 2)
  // Calculado: (price - cost) / price
  marginPct     Decimal? @db.Decimal(6, 4)
  changedById   String?
  reason        String?
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  changedBy AdminUser? @relation(fields: [changedById], references: [id])

  @@index([productId, effectiveFrom(sort: Desc)])
  @@map("product_price_history")
}

// Especificaciones técnicas (key / value)
model ProductSpec {
  id        String @id @default(uuid())
  productId String
  specKey   String
  specValue String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specs")
}

// Características (lista simple)
model ProductFeature {
  id        String @id @default(uuid())
  productId String
  feature   String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_features")
}

// =============================================================
// PROMOCIONES
// =============================================================

model Promotion {
  id             String          @id @default(uuid())
  name           String
  description    String?
  discountType   DiscountType
  discountValue  Decimal         @db.Decimal(10, 2)
  appliesTo      PromotionTarget @default(global)
  // Array de UUIDs de productos o categorías
  targetIds      String[]
  minOrderAmount Decimal?        @db.Decimal(12, 2)
  startsAt       DateTime
  endsAt         DateTime?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())

  orderItems OrderItem[]

  @@index([isActive, startsAt, endsAt])
  @@map("promotions")
}

// =============================================================
// CUPONES
// =============================================================

model Coupon {
  id                String          @id @default(uuid())
  code              String          @unique
  discountType      DiscountType
  discountValue     Decimal         @db.Decimal(10, 2)
  minOrderAmount    Decimal         @default(0) @db.Decimal(12, 2)
  maxDiscountAmount Decimal?        @db.Decimal(12, 2)
  usageLimit        Int?
  usageLimitPerUser Int             @default(1)
  timesUsed         Int             @default(0)
  appliesTo         PromotionTarget @default(global)
  targetIds         String[]
  startsAt          DateTime?
  expiresAt         DateTime?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  usages CouponUsage[]
  orders Order[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(uuid())
  couponId        String
  orderId         String   @unique
  customerId      String?
  guestEmail      String?
  discountApplied Decimal  @db.Decimal(12, 2)
  usedAt          DateTime @default(now())

  coupon   Coupon    @relation(fields: [couponId], references: [id])
  order    Order     @relation(fields: [orderId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@map("coupon_usages")
}

// =============================================================
// CLIENTES
// =============================================================

model Customer {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique
  phone           String?
  passwordHash    String
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses    CustomerAddress[]
  orders       Order[]
  carts        Cart[]
  reviews      ProductReview[]
  couponUsages CouponUsage[]

  @@index([email])
  @@index([createdAt])
  @@map("customers")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  alias         String?
  recipientName String
  phone         String?
  department    String
  province      String
  district      String
  addressLine   String
  reference     String?
  latitude      Decimal? @db.Decimal(10, 8)
  longitude     Decimal? @db.Decimal(11, 8)
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// =============================================================
// CARRITO
// =============================================================

model Cart {
  id         String     @id @default(uuid())
  token      String     @unique @default(uuid())
  customerId String?
  status     CartStatus @default(active)
  // Referencia al pedido cuando está en checkout_in_progress
  orderId    String?    @unique
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([token])
  @@index([customerId])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id             String    @id @default(uuid())
  cartId         String
  productId      String
  quantity       Int
  // Snapshot del precio al momento de agregar
  unitPrice      Decimal   @db.Decimal(12, 2)
  // Para detectar si el precio cambió desde que se agregó
  priceUpdatedAt DateTime?
  addedAt        DateTime  @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // Un producto solo puede aparecer una vez por carrito
  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

// =============================================================
// MÉTODOS DE PAGO
// =============================================================

model PaymentMethod {
  id           String            @id @default(uuid())
  code         String            @unique
  name         String
  type         PaymentMethodType
  // Config dinámica: { public_key, secret_key, environment }
  // { phone_number, qr_image_path } | { whatsapp_number } etc.
  config       Json              @default("{}")
  instructions String?
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  orders       Order[]
  transactions OrderPaymentTransaction[]

  @@index([isActive])
  @@map("payment_methods")
}

// =============================================================
// ZONAS DE ENVÍO
// =============================================================

model ShippingZone {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  areas  ShippingZoneArea[]
  rates  ShippingRate[]
  orders Order[]

  @@map("shipping_zones")
}

model ShippingZoneArea {
  id         String  @id @default(uuid())
  zoneId     String
  department String
  // null = aplica a todo el departamento
  province   String?
  // null = aplica a toda la provincia
  district   String?

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([department, province, district])
  @@map("shipping_zone_areas")
}

model ShippingRate {
  id                    String   @id @default(uuid())
  zoneId                String
  name                  String
  price                 Decimal  @db.Decimal(10, 2)
  minOrderAmount        Decimal  @default(0) @db.Decimal(12, 2)
  // Monto para obtener envío gratis (null = nunca)
  freeShippingThreshold Decimal? @db.Decimal(12, 2)
  estimatedDaysMin      Int?
  estimatedDaysMax      Int?
  isActive              Boolean  @default(true)

  zone ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@map("shipping_rates")
}

// =============================================================
// PEDIDOS
// =============================================================

model Order {
  id              String      @id @default(uuid())
  // Formato legible: ORD-20240101-0001
  orderNumber     String      @unique
  // Cliente registrado o invitado (uno de los dos siempre presente)
  customerId      String?
  guestEmail      String?
  guestName       String?
  guestPhone      String?
  status          OrderStatus @default(pending_payment)
  subtotal        Decimal     @db.Decimal(12, 2)
  discountAmount  Decimal     @default(0) @db.Decimal(12, 2)
  shippingAmount  Decimal     @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  couponId        String?
  couponDiscount  Decimal     @default(0) @db.Decimal(12, 2)
  paymentMethodId String
  // Snapshot de la dirección al momento del pedido (no FK)
  shippingAddress Json
  shippingZoneId  String?
  notes           String?
  adminNotes      String?
  ipAddress       String?
  placedAt        DateTime    @default(now())
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer      Customer?                 @relation(fields: [customerId], references: [id])
  coupon        Coupon?                   @relation(fields: [couponId], references: [id])
  paymentMethod PaymentMethod             @relation(fields: [paymentMethodId], references: [id])
  shippingZone  ShippingZone?             @relation(fields: [shippingZoneId], references: [id])
  items         OrderItem[]
  transactions  OrderPaymentTransaction[]
  statusHistory OrderStatusHistory[]
  reviews       ProductReview[]
  couponUsage   CouponUsage?
  complaints    Complaint[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt(sort: Desc)])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String
  // Snapshots: nunca depender del producto actual para datos históricos
  productName    String
  productSku     String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  unitCost       Decimal? @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  // (unitPrice - discountAmount) * quantity
  lineTotal      Decimal  @db.Decimal(12, 2)
  promotionId    String?

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id])
  promotion Promotion? @relation(fields: [promotionId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderPaymentTransaction {
  id                   String            @id @default(uuid())
  orderId              String
  paymentMethodId      String
  status               TransactionStatus @default(pending)
  amount               Decimal           @db.Decimal(12, 2)
  currency             String            @default("PEN") @db.Char(3)
  // ID único del gateway (Culqi charge id, etc.) — UNIQUE para idempotencia
  gatewayTransactionId String?           @unique
  // Para PagoEfectivo
  cipCode              String?
  cipExpiresAt         DateTime?
  // Respuesta completa del gateway (auditoría)
  gatewayResponse      Json              @default("{}")
  paidAt               DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  order         Order         @relation(fields: [orderId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([orderId])
  @@map("order_payment_transactions")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  // null = cambio automático por sistema o webhook
  changedById String?
  comment     String?
  createdAt   DateTime     @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy AdminUser? @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_history")
}

// =============================================================
// RESEÑAS
// =============================================================

model ProductReview {
  id         String    @id @default(uuid())
  productId  String
  customerId String
  // Verifica que el cliente haya comprado el producto
  orderId    String
  rating     Int
  title      String?
  comment    String?
  isApproved Boolean   @default(false)
  approvedAt DateTime?
  createdAt  DateTime  @default(now())

  product  Product  @relation(fields: [productId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  // Un cliente solo puede reseñar un producto una vez por compra
  @@unique([productId, customerId, orderId])
  @@index([productId])
  @@index([isApproved])
  @@map("product_reviews")
}

// =============================================================
// CONFIGURACIÓN DEL SITIO
// =============================================================

model SiteConfig {
  id                String   @id @default(uuid())
  storeName         String
  storeEmail        String
  supportEmail      String?
  phonePrimary      String?
  phoneSecondary    String?
  whatsappNumber    String?
  address           String?
  currency          String   @default("PEN") @db.Char(3)
  taxRate           Decimal  @default(0.18) @db.Decimal(5, 4)
  metaTitle         String?
  metaDescription   String?
  googleAnalyticsId String?
  facebookPixelId   String?
  updatedAt         DateTime @updatedAt

  socialLinks SocialLink[]

  @@map("site_config")
}

model SocialLink {
  id           String  @id @default(uuid())
  siteConfigId String
  network      String
  name         String
  icon         String?
  url          String
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)

  siteConfig SiteConfig @relation(fields: [siteConfigId], references: [id], onDelete: Cascade)

  @@index([siteConfigId])
  @@map("social_links")
}

// =============================================================
// HERO SLIDER
// =============================================================

model HeroSlide {
  id             String    @id @default(uuid())
  title          String?
  subtitle       String?
  linkType       LinkType  @default(none)
  linkProductId  String?
  linkCategoryId String?
  linkUrl        String?
  linkText       String?
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  linkProduct  Product?  @relation(fields: [linkProductId], references: [id])
  linkCategory Category? @relation(fields: [linkCategoryId], references: [id])

  @@index([isActive, sortOrder])
  @@map("hero_slides")
}

// =============================================================
// PÁGINAS ESTÁTICAS
// =============================================================

model Page {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  content         String? // HTML richText
  metaTitle       String?
  metaDescription String?
  status          PageStatus @default(draft)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  @@index([slug])
  @@index([status])
  @@map("pages")
}

// =============================================================
// LIBRO DE RECLAMACIONES
// =============================================================

model Complaint {
  id             String          @id @default(uuid())
  ticketNumber   String          @unique
  customerName   String
  documentType   String
  documentNumber String
  email          String
  phone          String?
  orderId        String?
  orderNumber    String?
  complaintType  ComplaintType
  description    String
  status         ComplaintStatus @default(open)
  adminResponse  String?
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  order Order? @relation(fields: [orderId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("complaints")
}

// =============================================================
// ADMINISTRACIÓN — USUARIOS, ROLES Y PERMISOS
// =============================================================

model AdminRole {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  users       AdminUser[]
  permissions AdminRolePermission[]

  @@map("admin_roles")
}

model AdminPermission {
  id     String                @id @default(uuid())
  // Formato: "products:create" | "orders:update" | "reports:view"
  code   String                @unique
  name   String
  module AdminPermissionModule

  roles AdminRolePermission[]

  @@index([module])
  @@map("admin_permissions")
}

model AdminRolePermission {
  roleId       String
  permissionId String

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  roleId       String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role               AdminRole             @relation(fields: [roleId], references: [id])
  priceChanges       ProductPriceHistory[]
  orderStatusChanges OrderStatusHistory[]

  @@index([email])
  @@map("admin_users")
}
