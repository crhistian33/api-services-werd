<!-- templates/order-pending-payment.hbs -->

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f7f9;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .header {
            background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%);
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .content {
            padding: 40px;
            color: #334155;
            line-height: 1.6;
        }
        .greeting {
            font-size: 18px;
            margin-bottom: 20px;
        }
        .order-box {
            background-color: #fffbeb;
            border: 1px solid #fde68a;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        .order-number {
            font-size: 24px;
            font-weight: 700;
            color: #d97706;
            margin-bottom: 10px;
        }
        .total {
            font-size: 32px;
            font-weight: 700;
            color: #1e293b;
            margin: 10px 0;
        }
        .payment-instructions {
            background-color: #f8fafc;
            border-left: 4px solid #f59e0b;
            padding: 16px;
            margin: 20px 0;
        }
        .whatsapp-box {
            background-color: #25D366;
            color: white;
            padding: 16px;
            border-radius: 8px;
            text-align: center;
            margin: 20px 0;
        }
        .whatsapp-box a {
            color: white;
            text-decoration: none;
            font-weight: 700;
            font-size: 18px;
        }
        .expires-box {
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
            padding: 16px;
            margin: 20px 0;
            text-align: center;
        }
        .expires-box strong {
            color: #dc2626;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>⏳ Pedido Pendiente de Pago</h1>
        </div>
        <div class="content">
            <p class="greeting">Hola <strong>{{customerName}}</strong>,</p>
            <p>¡Gracias por tu compra! Hemos recibido tu pedido y estamos esperando tu pago para comenzar a prepararlo.</p>
            
            <div class="order-box">
                <div class="order-number">{{orderNumber}}</div>
                <p style="margin: 5px 0; color: #64748b;">Total a pagar:</p>
                <div class="total">S/ {{total}}</div>
            </div>

            <div class="payment-instructions">
                <h3 style="margin: 0 0 12px 0; color: #1e293b;">📋 Instrucciones de Pago</h3>
                <p style="margin: 8px 0;"><strong>Método de pago:</strong> {{paymentMethodName}}</p>
                {{#if paymentInstructions}}
                <p style="margin: 8px 0;">{{paymentInstructions}}</p>
                {{/if}}
            </div>

            {{#if whatsappNumber}}
            <div class="whatsapp-box">
                <p style="margin: 0 0 8px 0;">📱 Envía tu comprobante por WhatsApp</p>
                <a href="https://wa.me/{{whatsappNumber}}">
                    {{whatsappNumber}}
                </a>
            </div>
            {{/if}}

            <div class="expires-box">
                <i class="pi pi-clock"></i>
                <p style="margin: 0;"><strong>⏰ Fecha límite de pago:</strong></p>
                <p style="font-size: 18px; margin: 8px 0; font-weight: 700;">{{paymentExpiresAt}}</p>
                <p style="margin: 8px 0 0 0; font-size: 14px; color: #dc2626;">
                    Si no recibimos tu pago antes de esta fecha, tu pedido será cancelado automáticamente.
                </p>
            </div>

            <p style="margin-top: 20px;">Si ya realizaste el pago, por favor ignora este mensaje. Procesaremos tu pedido una vez que verifiquemos el pago.</p>
        </div>
        <div class="footer">
            &copy; 2026 Werd. Todos los derechos reservados.
        </div>
    </div>
</body>
</html>