<!-- templates/order-payment-confirmed.hbs -->

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #f4f7f9;
            margin: 0;
            padding: 0;
            -webkit-font-smoothing: antialiased;
        }
        .container {
            max-width: 600px;
            margin: 40px auto;
            background-color: #ffffff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }
        .header {
            background: linear-gradient(135deg, #059669 0%, #10b981 100%);
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 28px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        .content {
            padding: 40px;
            color: #334155;
            line-height: 1.6;
        }
        .greeting {
            font-size: 18px;
            margin-bottom: 20px;
        }
        .success-box {
            background-color: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 20px;
            margin: 20px 0;
            text-align: center;
        }
        .order-number {
            font-size: 24px;
            font-weight: 700;
            color: #059669;
            margin-bottom: 10px;
        }
        .total {
            font-size: 28px;
            font-weight: 700;
            color: #1e293b;
        }
        .footer {
            background-color: #f8fafc;
            padding: 20px;
            text-align: center;
            font-size: 14px;
            color: #94a3b8;
            border-top: 1px solid #f1f5f9;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>✅ ¡Pago Confirmado!</h1>
        </div>
        <div class="content">
            <p class="greeting">Hola <strong>{{customerName}}</strong>,</p>
            <p>Hemos verificado tu pago y tu pedido está siendo preparado.</p>
            
            <div class="success-box">
                <div class="order-number">{{orderNumber}}</div>
                <p style="margin: 10px 0;">Número de operación: {{operationNumber}}</p>
                <p style="margin: 10px 0;">Método de pago: {{paymentMethod}}</p>
                <p style="margin: 10px 0; font-size: 14px; color: #64748b;">
                    Confirmado el {{confirmedAt}}
                </p>
                <div class="total" style="margin-top: 16px;">S/ {{total}}</div>
            </div>

            <p>Tu pedido está siendo procesado. Te notificaremos cuando sea enviado.</p>
        </div>
        <div class="footer">
            &copy; 2026 Werd. Todos los derechos reservados.
        </div>
    </div>
</body>
</html>